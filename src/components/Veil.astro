{/* The Veil v6 — rooms: one parametrized flesh shader, a tissue per room, the dive (tunnel) between rooms. Also owns the room router.
   Mouse-reactive on desktop, scroll-reactive on touch (90% of visits).
   Renders at 1/2 res, upscaled smooth: no dither, no pixels — liquid. */}
<canvas id="veil" aria-hidden="true"></canvas>

<script>
  import { ep } from '../data/ep';
  const cv = document.getElementById('veil') as HTMLCanvasElement;
  const gl = cv.getContext('webgl', { antialias: false, alpha: false });
  gl?.getExtension('OES_standard_derivatives');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(hover: none)').matches;

  /* ── el sello es el reproductor: <audio> vive fuera del altar y sigue sonando en los cuartos ── */
  const au = document.getElementById('ep') as HTMLAudioElement;
  const altar = document.querySelector<HTMLElement>('.altar')!;
  const playBtn = altar.querySelector<HTMLButtonElement>('.play')!;
  const pips = Array.from(altar.querySelectorAll<HTMLButtonElement>('.pips button'));
  const now = altar.querySelector<HTMLElement>('.demons')!, clock = altar.querySelector<HTMLElement>('.ep-time')!;
  const total = ep.tracks.reduce((s, t) => s + t.dur, 0);
  let i = -1, kick = 0, tickRaf = 0, avg = 0;
  let ctx: AudioContext | undefined, an: AnalyserNode | undefined;
  const buf = new Uint8Array(3); // bins 0..2 con fftSize 512 @ 44.1k = 0–258 Hz: el bombo
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const load = (n: number) => {
    i = n; const t = ep.tracks[n];
    au.src = t.src;
    now.textContent = `${String(t.n).padStart(2, '0')} · ${t.titulo}`;
    altar.classList.add('ep');
    pips.forEach((b, j) => j === n ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current'));
    if ('mediaSession' in navigator) navigator.mediaSession.metadata = new MediaMetadata({ title: t.titulo, artist: 'EXSIX', album: ep.title, artwork: [{ src: '/media/arte/logo-v6.webp', type: 'image/webp' }] });
  };
  const start = () => {            // siempre dentro del gesto: iOS lo exige para AudioContext y play()
    if (i < 0) load(0);
    if (!ctx && !still) {          // createMediaElementSource: una sola vez por elemento
      ctx = new AudioContext(); an = ctx.createAnalyser(); an.fftSize = 512; an.smoothingTimeConstant = .3;
      ctx.createMediaElementSource(au).connect(an); an.connect(ctx.destination);
    }
    ctx?.resume(); au.play().catch(() => {});
  };
  playBtn.addEventListener('click', () => au.paused ? start() : au.pause());
  pips.forEach((b, n) => b.addEventListener('click', () => { load(n); start(); }));
  au.addEventListener('ended', () => { if (i + 1 < ep.tracks.length) { load(i + 1); au.play(); } });
  const tick = () => {
    const before = ep.tracks.slice(0, i).reduce((s, t) => s + t.dur, 0);
    altar.style.setProperty('--p', ((before + au.currentTime) / total).toFixed(4));
    clock.textContent = `${fmt(au.currentTime)} / ${fmt(ep.tracks[i].dur)}`;
    if (an) {
      an.getByteFrequencyData(buf);
      const e = (buf[0] + buf[1] + buf[2]) / 765;
      avg += (e - avg) * .03;                                  // línea base adaptativa: el dron no cuenta, el golpe sí
      kick = Math.max(kick * .86, Math.min(1, (e - avg) * 5)); // ponytail: ganancia 5 / caída .86 a ojo, ajustar con el EP real
      altar.style.setProperty('--kick', kick.toFixed(3));
    }
    tickRaf = requestAnimationFrame(tick);
  };
  au.addEventListener('play', () => { altar.classList.add('playing'); playBtn.setAttribute('aria-pressed', 'true'); cancelAnimationFrame(tickRaf); tickRaf = requestAnimationFrame(tick); });
  au.addEventListener('pause', () => { altar.classList.remove('playing'); playBtn.setAttribute('aria-pressed', 'false'); cancelAnimationFrame(tickRaf); kick = 0; altar.style.setProperty('--kick', '0'); });
  if ('mediaSession' in navigator) {
    navigator.mediaSession.setActionHandler('play', start);
    navigator.mediaSession.setActionHandler('pause', () => au.pause());
    navigator.mediaSession.setActionHandler('previoustrack', () => { load(Math.max(0, i - 1)); au.play(); });
    navigator.mediaSession.setActionHandler('nexttrack', () => { load(Math.min(ep.tracks.length - 1, i + 1)); au.play(); });
  }

  if (gl) {
    const FRAG = `
#ifdef GL_OES_standard_derivatives
#extension GL_OES_standard_derivatives : enable
#endif
precision mediump float;
uniform vec2 u_res; uniform float u_t; uniform vec2 u_m; uniform float u_dive;
uniform vec2 u_kick; /* x: golpe grave 0..1 del analyser, y: reproduciendo 0..1 (suavizado) */
/* tissue: colors dark/lit/glow/spec; k1 = vein, specPow, beat, stretch; k2 = scale, pits, cover, crawl */
uniform vec3 u_c0,u_c1,u_c2,u_c3; uniform vec4 u_k1,u_k2;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
  return mix(mix(h(i),h(i+vec2(1.,0.)),f.x),mix(h(i+vec2(0.,1.)),h(i+1.),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*n(p);p*=2.03;a*=.5;}return v;}
/* tar: warp of a warp, slow — it folds, it never drifts */
float tar(vec2 p,float t){
  vec2 q=vec2(fbm(p*1.1+vec2(t*.3,-t*.2)),fbm(p*1.2-vec2(t*.25,t*.35)));
  vec2 r=vec2(fbm(p*1.7+3.2*q+vec2(t*.1,0.)),fbm(p*1.7+3.2*q-vec2(0.,t*.15)));
  return fbm(p*2.1+2.6*r);
}
void main(){
  vec2 uv=gl_FragCoord.xy/u_res;
  float asp=u_res.x/u_res.y;
  /* dive: the tunnel pulls everything toward the center and speeds time up */
  vec2 cuv=uv-.5;
  float dist=length(cuv*vec2(asp,1.));
  uv=.5+cuv*(1.-u_dive*.6*(1.-dist*.4));
  vec2 p=uv*vec2(asp,1.);
  float tt=u_t*(1.+u_dive*5.);
  float t=tt*.03;
  vec2 mp=(u_m-.5)*vec2(asp,1.);
  /* heartbeat ~66 bpm: lub, then a softer dub — amplitude is the tissue's */
  float ph=fract(u_t*1.1);
  float synth=exp(-ph*9.)+.5*exp(-max(ph-.24,0.)*14.)*step(.24,ph);
  /* mientras suena el EP el golpe real sustituye al latido sintético; a tejidos sin pulso se les presta uno */
  float beat=mix(synth,u_kick.x*1.3,u_kick.y)*(max(u_k1.z,u_kick.y*.8)+u_dive*1.5);
  /* peristalsis: the wall crawls; the beat squeezes it inward */
  p.y+=.035*u_k2.w*sin(p.x*2.6+tt*.5);
  p=(p-vec2(asp*.5,.5))*(1.-beat*.018)+vec2(asp*.5,.5);
  /* fibres: stretch the field along x (muscle), scale it (bone, fat) */
  vec2 fp=vec2(p.x/u_k1.w,p.y*u_k1.w)*u_k2.x;
  float f=tar(fp,t);
  float pit=smoothstep(.58,.8,n(p*9.*u_k2.x+vec2(t*.3)))*u_k2.y;
  float pull=smoothstep(.65,.0,distance(uv,u_m))*.28;
  float depth=mix(.6,.32,uv.y)+u_k2.z*.25;
  float hgt=f+pull+depth-.5+beat*.05-pit*.22;
  float blob=smoothstep(.36,.64,hgt);
  float thick=smoothstep(.55,.95,hgt);
#ifdef GL_OES_standard_derivatives
  vec3 N=normalize(vec3(-dFdx(hgt)*240.,-dFdy(hgt)*240.,1.));
#else
  vec2 e=vec2(.012,0.);
  vec3 N=normalize(vec3(-(tar(fp+e.xy,t)-f)*60.,-(tar(fp+e.yx,t)-f)*60.,1.));
#endif
  vec3 L=normalize(vec3((mp-(p-vec2(asp*.5,.5)))*2.,.7));
  vec3 V=vec3(0.,0.,1.);
  float spec=pow(max(dot(N,normalize(L+V)),0.),u_k1.y);
  float rim=pow(1.-max(dot(N,V),0.),2.6);
  vec3 base=mix(u_c0,u_c1,blob);
  vec3 sss=u_c2*thick*(.7+.5*beat);
  float irid=.5+.5*sin(dot(N.xy,vec2(9.,7.))+hgt*14.);
  vec3 film=mix(vec3(.12,0.,.14),vec3(.05,.08,.07),irid);
  /* veins: thin ridges that flush with every beat */
  float vn=fbm(fp*3.4+vec2(t*.6,-t*.4));
  float vein=smoothstep(.055,0.,abs(vn-.5))*blob*u_k1.x;
  vec3 col=base+sss+film*rim*blob+u_c3*spec*blob*(.5+.5*blob)*(.75+.5*beat);
  col+=mix(vec3(.6,.03,.05),u_c2*1.4,step(1.5,u_k1.x))*vein*(.45+.75*beat);
  col-=pit*.35*blob;
  /* bubbles: slow, inside the goo, ring highlights */
  vec2 ep=vec2(p.x,p.y-u_t*.014)*28.;
  vec2 cell=floor(ep);
  float e=step(.986,h(cell));
  float rr=length(fract(ep)-.5);
  float bub=e*smoothstep(.035,0.,abs(rr-.27))*blob*(.6+.4*sin(u_t*1.3+h(cell)*40.));
  col+=u_c2*.9*bub;
  /* tunnel vignette while diving */
  col*=1.-u_dive*smoothstep(.15,.85,dist);
  gl_FragColor=vec4(col,1.);
}`;
    const VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
    const sh = (t: number, s: string) => {
      const o = gl.createShader(t)!; gl.shaderSource(o, s); gl.compileShader(o); return o;
    };
    const pr = gl.createProgram()!;
    gl.attachShader(pr, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(pr); gl.useProgram(pr);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(pr, 'a');
    gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(pr, n);
    const uRes = U('u_res'), uT = U('u_t'), uM = U('u_m'), uDive = U('u_dive'), uKick = U('u_kick');
    const uC = [U('u_c0'), U('u_c1'), U('u_c2'), U('u_c3')], uK = [U('u_k1'), U('u_k2')];

    /* a tissue = 20 floats: dark rgb, lit rgb, glow rgb, spec rgb, [vein specPow beat stretch], [scale pits cover crawl] */
    const T: Record<string, number[]> = {
      altar:          [.02,0,.004,     .24,.012,.022,.42,.05,.06,  .95,.72,.7,   1,32,1,1,     1,0,0,1],      // víscera
      curse:          [.02,0,.004,     .24,.012,.022,.42,.05,.06,  .95,.72,.7,   1,32,1,1,     1,0,.1,1],     // estómago
      manifestations: [.03,.04,.005,   .35,.42,.04,  .45,.5,.05,   .95,1,.7,     .3,45,.4,1,   .8,0,.3,1.4],  // bilis
      clothes:        [.03,.04,.05,    .55,.62,.66,  .25,.3,.34,   .9,.95,1,     .15,60,.2,1,  .7,.3,.3,.3],  // cartílago
      reveletions:    [.04,.035,.03,   .42,.37,.31,  .16,.13,.1,   .5,.47,.42,   0,8,0,1,      1.4,1,.22,0],  // hueso
      darkroom:       [.015,0,.003,    .16,0,.015,   .3,.02,.03,   .95,.9,.9,    0,50,.6,1,    1,0,.2,1.5],   // sangre
      crypt:          [.01,.008,.02,   .08,.06,.1,   .17,.12,.3,   .7,.66,.85,   2.2,40,2.5,2, .8,0,.15,.4],  // nervio
      industries:     [.08,.06,.02,    .65,.55,.2,   .6,.45,.1,    1,.95,.7,     .2,14,.3,1,   1.6,.8,.5,.2], // grasa
      colectivo:      [.05,0,.01,      .42,.03,.04,  .5,.08,.06,   .9,.6,.55,    .6,20,1.6,3,  1,0,.2,1.2],   // músculo
      libro:          [.03,0,.006,     .3,.02,.03,   .45,.06,.07,  .95,.75,.72,  1.2,28,1.1,1, .9,0,.3,1.1],  // entraña
      bitacora:       [.06,.02,.03,    .5,.22,.26,   .6,.25,.3,    1,.85,.85,    .9,40,.5,1.5, .5,0,.4,.6],   // membrana
    };
    const cur = T.altar.slice(); let tgt = T.altar;
    const push = () => {
      for (let i = 0; i < 4; i++) gl.uniform3f(uC[i], cur[i*3], cur[i*3+1], cur[i*3+2]);
      gl.uniform4f(uK[0], cur[12], cur[13], cur[14], cur[15]);
      gl.uniform4f(uK[1], cur[16], cur[17], cur[18], cur[19]);
    };

    /* rooms: the altar is the lobby, every section is a room; a door is a dive, never a scroll */
    const root = document.documentElement;
    const marks = Array.from(document.querySelectorAll<HTMLElement>('h2.ordo[id]'));
    const order = marks.map(h => h.id);
    const door = (k: string) => document.querySelector<HTMLAnchorElement>(`.doors .${k}`)!;
    const show = (id: string | null, focus = true) => {
      if (id) root.dataset.room = id; else delete root.dataset.room;
      marks.forEach(h => h.classList.toggle('on', h.id === id));
      const i = id ? order.indexOf(id) : -1;
      const set = (k: string, to: string | undefined) => {
        const a = door(k); a.hidden = !to;
        if (to) { a.href = '#' + to; a.querySelector('span')!.textContent = marks[order.indexOf(to)].querySelector('b')!.textContent; }
      };
      set('prev', i > 0 ? order[i - 1] : undefined);
      set('next', i >= 0 && i < order.length - 1 ? order[i + 1] : undefined);
      scrollTo(0, 0);
      tgt = T[id ?? 'altar'] ?? T.altar;
      const h = id ? marks[i] : playBtn;
      if (h && focus) { if (h !== playBtn) h.tabIndex = -1; h.focus({ preventScroll: true }); }
    };
    let dive = 0, diveTo = 0, pl = 0;
    const go = (id: string | null, push = true) => {
      const url = id ? '#' + id : location.pathname;
      if (still) { show(id); if (push) history.pushState(null, '', url); return; }
      diveTo = 1;
      root.style.setProperty('--sy', scrollY + 'px');
      root.classList.add('dive');
      setTimeout(() => {
        /* swap rooms with the page untransformed, then surface from small */
        root.classList.remove('dive'); root.classList.add('jump'); void root.offsetWidth;
        show(id); if (push) history.pushState(null, '', url);
        root.style.setProperty('--sy', '0px');
        root.classList.replace('jump', 'arrive'); void root.offsetWidth; root.classList.remove('arrive');
        diveTo = 0;
      }, 520);
    };
    const fromHash = () => { const h = location.hash.slice(1); return order.includes(h) ? h : null; };
    document.addEventListener('click', e => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute('href')!.slice(1);
      if (id === 'altar' || id === 'top' || id === '') { e.preventDefault(); go(null); }
      else if (order.includes(id)) { e.preventDefault(); if (id !== root.dataset.room) go(id); }
    });
    addEventListener('popstate', () => go(fromHash(), false));
    show(fromHash(), false);

    const size = () => {
      cv.width = Math.max(2, Math.floor(innerWidth / 2));
      cv.height = Math.max(2, Math.floor(innerHeight / 2));
      gl.viewport(0, 0, cv.width, cv.height);
      gl.uniform2f(uRes, cv.width, cv.height);
    };
    size(); addEventListener('resize', size);

    let mx = 0.5, my = 0.35, tx = 0.5, ty = 0.35;
    if (!touch) {
      addEventListener('pointermove', e => { tx = e.clientX / innerWidth; ty = 1 - e.clientY / innerHeight; }, { passive: true });
    }

    const frame = (ms: number) => {
      if (touch) {
        /* the fog focus descends with you: deeper scroll, lower pull */
        const max = document.documentElement.scrollHeight - innerHeight;
        ty = 1 - (max > 0 ? scrollY / max : 0) * 0.85;
        tx = 0.5 + Math.sin(ms / 9000) * 0.2;
      }
      mx += (tx - mx) * 0.025; my += (ty - my) * 0.025;
      dive += (diveTo - dive) * 0.14;
      /* tissues morph fast inside the tunnel, slow otherwise */
      const k = dive > .3 ? 0.12 : 0.03;
      for (let i = 0; i < 20; i++) cur[i] += (tgt[i] - cur[i]) * k;
      push();
      gl.uniform1f(uT, ms / 1000); gl.uniform2f(uM, mx, my); gl.uniform1f(uDive, dive);
      pl += ((au.paused ? 0 : 1) - pl) * .05; gl.uniform2f(uKick, kick, pl);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    if (still) { frame(40000); }
    else {
      let raf = 0;
      const loop = (ms: number) => { frame(ms); raf = requestAnimationFrame(loop); };
      raf = requestAnimationFrame(loop);
      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(raf);
        if (!document.hidden) raf = requestAnimationFrame(loop);
      });
    }
  }
</script>
