---
import Veil from '../components/Veil.astro';
import '../styles/global.css';
const updated = '02.08.2026';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EXSIX — sonido · film · ropa</title>
  <meta name="description" content="EXSIX es un colectivo de seis. Grabamos nuestra música, filmamos nuestros videos y cortamos nuestra propia ropa. Hecho a mano, en la oscuridad." />
  <meta property="og:title" content="EXSIX" />
  <meta property="og:description" content="Sonido. Film. Ropa. Somos seis, sin dioses ni sellos." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Jacquard+12&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#manifiesto">Saltar al contenido</a>
  <Veil />
  <div class="grain" aria-hidden="true"></div>

  <div class="shell">
    <header class="mast">
      <span class="site">EXSIX<em>.</em>NET</span>
      <span>est. MMXXVI</span>
      <span>última actualización: {updated}</span>
    </header>

    <div class="tick" aria-hidden="true">
      <div>
        <span>✠</span> bienvenido al santuario <span>✠</span> sin dioses ni sellos <span>✠</span> somos seis <span>✠</span> sonido film ropa <span>✠</span> firma el libro
        <span>✠</span> bienvenido al santuario <span>✠</span> sin dioses ni sellos <span>✠</span> somos seis <span>✠</span> sonido film ropa <span>✠</span> firma el libro
      </div>
    </div>

    <nav aria-label="Secciones">
      <ul class="nav">
        <li><a href="#manifiesto">manifiesto</a></li>
        <li><a href="#ritos">ritos</a></li>
        <li><a href="#visiones">visiones</a></li>
        <li><a href="#reliquias">reliquias</a></li>
        <li><a href="#los-seis">los seis</a></li>
        <li><a href="#libro">libro de visitas</a></li>
      </ul>
    </nav>

    <main>
      <!-- PORTAL: enmarcado con los thorns cromados calcados de la ref -->
      <section class="box hero">
        <div class="frame-art frame-chrome" aria-hidden="true"></div>
        <svg class="sigil" viewBox="0 0 400 400" role="img" aria-label="Sigilo de EXSIX: las letras XG dentro de un anillo de seis puntas">
          <g class="halo">
            <circle class="thread" cx="200" cy="200" r="178" />
            <circle class="thread" cx="200" cy="200" r="150" stroke-dasharray="2 7" />
            <path class="thread" d="M200 50 L70.1 275 L329.9 275 Z" />
            <path class="thread" d="M200 350 L70.1 125 L329.9 125 Z" />
            {[0, 60, 120, 180, 240, 300].map(a => (
              <path class="fang" d="M194 38 L200 -10 L206 38 L200 22 Z" transform={`rotate(${a} 200 200)`} />
            ))}
            {[30, 90, 150, 210, 270, 330].map(a => (
              <path class="fang minor" d="M197 24 L200 0 L203 24 Z" transform={`rotate(${a} 200 200)`} />
            ))}
          </g>
          <text class="glyph" x="200" y="252">XG</text>
        </svg>
        <h1>EXSIX</h1>
        <p class="sub">sonido <b>✠</b> film <b>✠</b> ropa</p>
      </section>

      <!-- MANIFIESTO -->
      <section class="box" id="manifiesto">
        <div class="drips" aria-hidden="true">
          <svg viewBox="0 0 400 30" preserveAspectRatio="none"><path fill="currentColor" d="M0 0 H400 V3 H372 L369 15 Q368 18 366.5 15 L364 3 H331 L329 9 Q328 11 327 9 L326 3 H284 L281 21 Q279.5 25 278 21 L276 3 H230 L228 8 Q227 10 226 8 L225 3 H172 L169 13 Q167.5 16.5 166 13 L164 3 H118 L116 7 Q115 9 114 7 L113 3 H67 L64 17 Q62.5 20.5 61 17 L59 3 H0 Z"/></svg>
          <i class="gota" style="left:19%"></i><i class="gota" style="left:55%"></i><i class="gota" style="left:83%"></i>
        </div>
        <div class="bar">✠ 01 — manifiesto <small>lee esto primero</small></div>
        <h2>Todo lo hacemos <span class="x">nosotros</span>.</h2>
        <p>
          EXSIX es un colectivo: seis personas y un taller. Grabamos nuestra música,
          filmamos nuestros videos, cortamos nuestra propia ropa. Nadie nos firmó.
          Nadie pidió permiso. Cada cosa en este sitio se hizo a mano, de noche,
          y lleva el nombre de quien la hizo.
        </p>
      </section>

      <!-- RITOS -->
      <section class="box" id="ritos">
        <div class="claw tl" aria-hidden="true"></div>
        <div class="claw br" aria-hidden="true"></div>
        <div class="bar">✠ 02 — ritos <small>el disco</small></div>
        <table>
          <thead>
            <tr><th scope="col">nº</th><th scope="col">título</th><th scope="col" style="text-align:right">forma</th></tr>
          </thead>
          <tbody>
            <tr><td class="no">I</td><td class="title">Ashfall</td><td class="meta">sencillo · 2026</td></tr>
            <tr><td class="no">II</td><td class="title">Hollow Choir</td><td class="meta">EP · 2026</td></tr>
            <tr><td class="no">III</td><td class="title">Teeth of the Garden</td><td class="meta">sencillo · 2025</td></tr>
            <tr><td class="no">IV</td><td class="title">Untitled Rite</td><td class="meta">inédito</td></tr>
          </tbody>
        </table>
        <div class="slot">[ aquí se invocará el embed de spotify / youtube ]</div>
      </section>

      <!-- VISIONES -->
      <section class="box" id="visiones">
        <div class="bar">✠ 03 — visiones <small>el film</small></div>
        <h2>Imágenes en <span class="x">movimiento</span>.</h2>
        <div class="plates">
          <a class="plate" href="#visiones"><span class="field" aria-hidden="true"></span><span class="tag">ashfall — video</span></a>
          <a class="plate" href="#visiones"><span class="field" aria-hidden="true"></span><span class="tag">estudio, de noche</span></a>
          <a class="plate" href="#visiones"><span class="field" aria-hidden="true"></span><span class="tag">lookbook</span></a>
          <a class="plate" href="#visiones"><span class="field" aria-hidden="true"></span><span class="tag">ritual en vivo</span></a>
        </div>
      </section>

      <!-- RELIQUIAS -->
      <section class="box" id="reliquias">
        <div class="drips" aria-hidden="true">
          <svg viewBox="0 0 400 30" preserveAspectRatio="none"><path fill="currentColor" d="M0 0 H400 V3 H372 L369 15 Q368 18 366.5 15 L364 3 H331 L329 9 Q328 11 327 9 L326 3 H284 L281 21 Q279.5 25 278 21 L276 3 H230 L228 8 Q227 10 226 8 L225 3 H172 L169 13 Q167.5 16.5 166 13 L164 3 H118 L116 7 Q115 9 114 7 L113 3 H67 L64 17 Q62.5 20.5 61 17 L59 3 H0 Z"/></svg>
          <i class="gota" style="left:31%"></i><i class="gota" style="left:68%"></i><i class="gota" style="left:12%"></i>
        </div>
        <div class="bar">✠ 04 — reliquias <small>la ropa</small></div>
        <h2>Se porta, no se <span class="x">compra</span>.</h2>
        <div class="relics">
          <a class="relic" href="#reliquias">
            <span class="shot"><span class="glyphmark" aria-hidden="true">XG</span></span>
            <span class="line"><b>Thorn Hoodie</b><span>$—</span></span>
          </a>
          <a class="relic" href="#reliquias">
            <span class="shot"><span class="glyphmark" aria-hidden="true">VI</span></span>
            <span class="line"><b>Ashfall Tee</b><span>$—</span></span>
          </a>
          <a class="relic" href="#reliquias">
            <span class="shot"><span class="glyphmark" aria-hidden="true">✠</span></span>
            <span class="line"><b>Sigil Cap</b><span class="sold">agotado</span></span>
          </a>
          <a class="relic" href="#reliquias">
            <span class="shot"><span class="glyphmark" aria-hidden="true">†</span></span>
            <span class="line"><b>Drop 01 Jacket</b><span>$—</span></span>
          </a>
        </div>
      </section>

      <!-- LOS SEIS -->
      <section class="box" id="los-seis">
        <div class="claw tr" aria-hidden="true"></div>
        <div class="claw bl" aria-hidden="true"></div>
        <div class="bar">✠ 05 — los seis <small>quienes hicieron esto</small></div>
        <div class="six">
          <div class="member"><span class="rune" aria-hidden="true">I</span><p class="who">———</p><p class="role">voz</p></div>
          <div class="member"><span class="rune" aria-hidden="true">II</span><p class="who">———</p><p class="role">cuerdas</p></div>
          <div class="member"><span class="rune" aria-hidden="true">III</span><p class="who">———</p><p class="role">batería</p></div>
          <div class="member"><span class="rune" aria-hidden="true">IV</span><p class="who">———</p><p class="role">cámara</p></div>
          <div class="member"><span class="rune" aria-hidden="true">V</span><p class="who">SAYAN</p><p class="role">diseño y ropa</p></div>
          <div class="member"><span class="rune" aria-hidden="true">VI</span><p class="who">———</p><p class="role">producción</p></div>
        </div>
      </section>

      <!-- LIBRO DE VISITAS: enmarcado con el marco victoriano del murciélago -->
      <section class="box" id="libro">
        <div class="bar">✠ 06 — libro de visitas <small>deja tu marca</small></div>
        <div class="bat-orn" aria-hidden="true"></div>
        <form class="gb-form" id="gb">
          <label class="skip" for="gb-name">Nombre</label>
          <input type="text" id="gb-name" name="name" maxlength="40" placeholder="tu nombre" required />
          <label class="skip" for="gb-msg">Mensaje</label>
          <textarea id="gb-msg" name="msg" maxlength="280" placeholder="di algo. lo leemos todo." required></textarea>
          <button type="submit">firmar el libro</button>
        </form>
        <div id="gb-list" aria-live="polite"></div>
        <p class="gb-note">las firmas viven en tu navegador hasta que tengamos libro propio.</p>
      </section>

      <!-- BITÁCORA -->
      <section class="box" id="bitacora">
        <div class="bar">✠ 07 — bitácora <small>prueba de vida</small></div>
        <ul class="log">
          <li><span class="d">02.08.26</span><span>santuario v3 — picos calcados de las reliquias, sangre que gotea, español primero</span></li>
          <li><span class="d">02.08.26</span><span>v2 — la niebla respira, libro de visitas abierto, gótico de píxeles</span></li>
          <li><span class="d">02.08.26</span><span>v1 — una noche: negro, hueso, sangre</span></li>
          <li><span class="d">··.··.··</span><span>el colectivo se forma. somos seis. van a oír de nosotros.</span></li>
        </ul>
      </section>

      <!-- BADGES -->
      <div class="badges" aria-label="Insignias">
        <a class="badge bleed" href="#top">EXSIX ✠ X6</a>
        <a class="badge" href="#manifiesto">SIN DIOSES</a>
        <a class="badge" href="#libro">FIRMA EL LIBRO</a>
        <a class="badge blink" href="#ritos">SONANDO</a>
        <a class="badge" href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">IG ↗</a>
      </div>
    </main>

    <footer class="foot">
      <p class="ring"><a href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">◄ ant</a> · webring gótico · <a href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">sig ►</a></p>
      <p class="count">has entrado <b id="souls">000001</b> veces</p>
      <p>EXSIX © MMXXVI — hecho en la oscuridad</p>
    </footer>
  </div>

  <script>
    // contador de almas — honesto: cuenta TUS visitas, en tu navegador
    const k = 'exsix-souls';
    const n = (parseInt(localStorage.getItem(k) || '0', 10) || 0) + 1;
    localStorage.setItem(k, String(n));
    document.getElementById('souls')!.textContent = String(n).padStart(6, '0');

    // libro de visitas — local hasta que haya backend
    const K = 'exsix-book';
    const list = document.getElementById('gb-list')!;
    const form = document.getElementById('gb') as HTMLFormElement;
    const esc = (s: string) => s.replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`);
    const read = (): { name: string; msg: string; when: string }[] => {
      try { return JSON.parse(localStorage.getItem(K) || '[]'); } catch { return []; }
    };
    const render = () => {
      list.innerHTML = read().map(s =>
        `<div class="sig"><span class="from">${esc(s.name)}</span> <span class="when">${esc(s.when)}</span><br>${esc(s.msg)}</div>`
      ).join('');
    };
    form.addEventListener('submit', e => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim(), msg = String(fd.get('msg') || '').trim();
      if (!name || !msg) return;
      const book = read();
      book.unshift({ name, msg, when: new Date().toLocaleDateString('es-MX') });
      localStorage.setItem(K, JSON.stringify(book.slice(0, 50)));
      form.reset(); render();
    });
    render();

    // estela del cursor — cruces que caen, como los trails de 1999
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover:hover)').matches) {
      let last = 0;
      addEventListener('pointermove', e => {
        const now = performance.now();
        if (now - last < 48) return;
        last = now;
        const c = document.createElement('i');
        c.className = 'trail';
        c.style.left = e.clientX + 'px';
        c.style.top = e.clientY + 'px';
        document.body.appendChild(c);
        setTimeout(() => c.remove(), 720);
      }, { passive: true });
    }
  </script>
</body>
</html>
