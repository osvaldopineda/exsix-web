---
import Veil from '../components/Veil.astro';
import '../styles/global.css';
const updated = '02.08.2026';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EXSIX — sound · film · garment</title>
  <meta name="description" content="EXSIX is a collective of six. We write our own music, shoot our own film, and cut our own garments. Made by hand, in the dark." />
  <meta property="og:title" content="EXSIX" />
  <meta property="og:description" content="Sound. Film. Garment. Six of us, no gods, no labels." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Jacquard+12&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#manifest">Skip to content</a>
  <Veil />
  <div class="grain" aria-hidden="true"></div>

  <div class="shell">
    <header class="mast">
      <span class="site">EXSIX<em>.</em>NET</span>
      <span>est. MMXXVI</span>
      <span>last updated: {updated}</span>
    </header>

    <div class="tick" aria-hidden="true">
      <div>
        <span>✠</span> welcome to the shrine <span>✠</span> no gods no labels <span>✠</span> six of us <span>✠</span> sound film garment <span>✠</span> sign the guestbook
        <span>✠</span> welcome to the shrine <span>✠</span> no gods no labels <span>✠</span> six of us <span>✠</span> sound film garment <span>✠</span> sign the guestbook
      </div>
    </div>

    <nav aria-label="Sections">
      <ul class="nav">
        <li><a href="#manifest">manifest</a></li>
        <li><a href="#rites">rites</a></li>
        <li><a href="#visions">visions</a></li>
        <li><a href="#relics">relics</a></li>
        <li><a href="#six">the six</a></li>
        <li><a href="#guestbook">guestbook</a></li>
      </ul>
    </nav>

    <main>
      <!-- HERO -->
      <section class="box hero">
        <svg class="thorn tl" viewBox="0 0 74 74" aria-hidden="true">
          <path d="M2 72 C2 34 10 16 34 8 C20 22 18 34 24 46 M2 72 C14 60 30 58 44 62 C32 52 30 40 36 30 M10 10 L2 2 M26 6 L22 0 M6 26 L0 22" />
        </svg>
        <svg class="thorn tr" viewBox="0 0 74 74" aria-hidden="true">
          <path d="M2 72 C2 34 10 16 34 8 C20 22 18 34 24 46 M2 72 C14 60 30 58 44 62 C32 52 30 40 36 30 M10 10 L2 2 M26 6 L22 0 M6 26 L0 22" />
        </svg>
        <svg class="thorn bl" viewBox="0 0 74 74" aria-hidden="true">
          <path d="M2 72 C2 34 10 16 34 8 C20 22 18 34 24 46 M2 72 C14 60 30 58 44 62 C32 52 30 40 36 30 M10 10 L2 2 M26 6 L22 0 M6 26 L0 22" />
        </svg>
        <svg class="thorn br" viewBox="0 0 74 74" aria-hidden="true">
          <path d="M2 72 C2 34 10 16 34 8 C20 22 18 34 24 46 M2 72 C14 60 30 58 44 62 C32 52 30 40 36 30 M10 10 L2 2 M26 6 L22 0 M6 26 L0 22" />
        </svg>

        <svg class="sigil" viewBox="0 0 400 400" role="img" aria-label="EXSIX sigil: the letters XG inside a six-pointed ring">
          <g class="halo">
            <circle class="thread" cx="200" cy="200" r="178" />
            <circle class="thread" cx="200" cy="200" r="150" stroke-dasharray="2 7" />
            <path class="thread" d="M200 50 L70.1 275 L329.9 275 Z" />
            <path class="thread" d="M200 350 L70.1 125 L329.9 125 Z" />
            <path class="spike" d="M191 26 L200 2 L209 26" />
            <path class="spike" d="M191 26 L200 2 L209 26" transform="rotate(60 200 200)" />
            <path class="spike" d="M191 26 L200 2 L209 26" transform="rotate(120 200 200)" />
            <path class="spike" d="M191 26 L200 2 L209 26" transform="rotate(180 200 200)" />
            <path class="spike" d="M191 26 L200 2 L209 26" transform="rotate(240 200 200)" />
            <path class="spike" d="M191 26 L200 2 L209 26" transform="rotate(300 200 200)" />
          </g>
          <text class="glyph" x="200" y="252">XG</text>
        </svg>
        <h1>EXSIX</h1>
        <p class="sub">sound <b>✠</b> film <b>✠</b> garment</p>
      </section>

      <!-- MANIFEST -->
      <section class="box" id="manifest">
        <div class="bar">✠ 01 — manifest <small>read this first</small></div>
        <h2>We build it <span class="x">all</span> ourselves.</h2>
        <p>
          EXSIX is a collective. Six people, one workshop. We write and record our own music,
          shoot our own film, and cut our own garments. Nobody signed us. Nobody asked.
          Everything on this site was made by hand, in the dark, by the people whose names are on it.
        </p>
      </section>

      <!-- RITES -->
      <section class="box" id="rites">
        <div class="bar">✠ 02 — rites <small>the record</small></div>
        <table>
          <thead>
            <tr><th scope="col">no.</th><th scope="col">title</th><th scope="col" style="text-align:right">form</th></tr>
          </thead>
          <tbody>
            <tr><td class="no">I</td><td class="title">Ashfall</td><td class="meta">single · 2026</td></tr>
            <tr><td class="no">II</td><td class="title">Hollow Choir</td><td class="meta">EP · 2026</td></tr>
            <tr><td class="no">III</td><td class="title">Teeth of the Garden</td><td class="meta">single · 2025</td></tr>
            <tr><td class="no">IV</td><td class="title">Untitled Rite</td><td class="meta">unreleased</td></tr>
          </tbody>
        </table>
        <div class="slot">[ spotify / youtube embed will be summoned here ]</div>
      </section>

      <!-- VISIONS -->
      <section class="box" id="visions">
        <div class="bar">✠ 03 — visions <small>the film</small></div>
        <h2>Moving <span class="x">pictures</span>.</h2>
        <div class="plates">
          <a class="plate" href="#visions"><span class="field" aria-hidden="true"></span><span class="tag">ashfall — video</span></a>
          <a class="plate" href="#visions"><span class="field" aria-hidden="true"></span><span class="tag">studio, night</span></a>
          <a class="plate" href="#visions"><span class="field" aria-hidden="true"></span><span class="tag">lookbook film</span></a>
          <a class="plate" href="#visions"><span class="field" aria-hidden="true"></span><span class="tag">live ritual</span></a>
        </div>
      </section>

      <!-- RELICS -->
      <section class="box" id="relics">
        <div class="bar">✠ 04 — relics <small>the garment</small></div>
        <h2>Worn, not <span class="x">bought</span>.</h2>
        <div class="relics">
          <a class="relic" href="#relics">
            <span class="shot"><span class="glyphmark" aria-hidden="true">XG</span></span>
            <span class="line"><b>Thorn Hoodie</b><span>$—</span></span>
          </a>
          <a class="relic" href="#relics">
            <span class="shot"><span class="glyphmark" aria-hidden="true">VI</span></span>
            <span class="line"><b>Ashfall Tee</b><span>$—</span></span>
          </a>
          <a class="relic" href="#relics">
            <span class="shot"><span class="glyphmark" aria-hidden="true">✠</span></span>
            <span class="line"><b>Sigil Cap</b><span class="sold">sold out</span></span>
          </a>
          <a class="relic" href="#relics">
            <span class="shot"><span class="glyphmark" aria-hidden="true">†</span></span>
            <span class="line"><b>Drop 01 Jacket</b><span>$—</span></span>
          </a>
        </div>
      </section>

      <!-- THE SIX -->
      <section class="box" id="six">
        <div class="bar">✠ 05 — the six <small>who did this</small></div>
        <div class="six">
          <div class="member"><span class="rune" aria-hidden="true">I</span><p class="who">———</p><p class="role">voice</p></div>
          <div class="member"><span class="rune" aria-hidden="true">II</span><p class="who">———</p><p class="role">strings</p></div>
          <div class="member"><span class="rune" aria-hidden="true">III</span><p class="who">———</p><p class="role">drums</p></div>
          <div class="member"><span class="rune" aria-hidden="true">IV</span><p class="who">———</p><p class="role">camera</p></div>
          <div class="member"><span class="rune" aria-hidden="true">V</span><p class="who">SAYAN</p><p class="role">design &amp; garment</p></div>
          <div class="member"><span class="rune" aria-hidden="true">VI</span><p class="who">———</p><p class="role">production</p></div>
        </div>
      </section>

      <!-- GUESTBOOK -->
      <section class="box" id="guestbook">
        <div class="bar">✠ 06 — guestbook <small>leave a mark</small></div>
        <form class="gb-form" id="gb">
          <label class="skip" for="gb-name">Name</label>
          <input type="text" id="gb-name" name="name" maxlength="40" placeholder="your name" required />
          <label class="skip" for="gb-msg">Message</label>
          <textarea id="gb-msg" name="msg" maxlength="280" placeholder="say something. we read everything." required></textarea>
          <button type="submit">sign the book</button>
        </form>
        <div id="gb-list" aria-live="polite"></div>
        <p class="gb-note">signatures live in your browser until we get a real book.</p>
      </section>

      <!-- UPDATE LOG -->
      <section class="box" id="log">
        <div class="bar">✠ 07 — update log <small>proof of life</small></div>
        <ul class="log">
          <li><span class="d">02.08.26</span><span>shrine v2 — the veil breathes, guestbook opened, pixel gothic everywhere</span></li>
          <li><span class="d">02.08.26</span><span>shrine v1 built in one night. black, bone, blood.</span></li>
          <li><span class="d">··.··.··</span><span>the collective forms. six of us. you'll hear about it.</span></li>
        </ul>
      </section>

      <!-- BADGES -->
      <div class="badges" aria-label="Badges">
        <a class="badge bleed" href="#top">EXSIX ✠ X6</a>
        <a class="badge" href="#manifest">NO GODS</a>
        <a class="badge" href="#guestbook">SIGN THE BOOK</a>
        <a class="badge blink" href="#rites">NOW PLAYING</a>
        <a class="badge" href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">IG ↗</a>
      </div>
    </main>

    <footer class="foot">
      <p class="ring"><a href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">◄ prev</a> · goth webring · <a href="https://instagram.com/x6.exsix.x6" target="_blank" rel="noopener">next ►</a></p>
      <p class="count">you have entered <b id="souls">000001</b> times</p>
      <p>EXSIX © MMXXVI — made in the dark</p>
    </footer>
  </div>

  <script>
    // souls counter — honest: counts YOUR visits, in your browser
    const k = 'exsix-souls';
    const n = (parseInt(localStorage.getItem(k) || '0', 10) || 0) + 1;
    localStorage.setItem(k, String(n));
    document.getElementById('souls')!.textContent = String(n).padStart(6, '0');

    // guestbook — local until there's a backend
    const K = 'exsix-book';
    const list = document.getElementById('gb-list')!;
    const form = document.getElementById('gb') as HTMLFormElement;
    const esc = (s: string) => s.replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`);
    const read = (): { name: string; msg: string; when: string }[] => {
      try { return JSON.parse(localStorage.getItem(K) || '[]'); } catch { return []; }
    };
    const render = () => {
      list.innerHTML = read().map(s =>
        `<div class="sig"><span class="from">${esc(s.name)}</span> <span class="when">${esc(s.when)}</span><br>${esc(s.msg)}</div>`
      ).join('');
    };
    form.addEventListener('submit', e => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim(), msg = String(fd.get('msg') || '').trim();
      if (!name || !msg) return;
      const book = read();
      book.unshift({ name, msg, when: new Date().toLocaleDateString('en-GB') });
      localStorage.setItem(K, JSON.stringify(book.slice(0, 50)));
      form.reset(); render();
    });
    render();
  </script>
</body>
</html>
